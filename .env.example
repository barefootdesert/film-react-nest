# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=films

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Backend
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@database:5432/films
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
PORT=3000
LOGGER_TYPE=tskv

# Frontend build args
VITE_API_URL=/api/afisha
VITE_CDN_URL=/content/afisha

# GitHub Container Registry (для docker-compose)
GITHUB_REPOSITORY=barefootdesert/film-react-nest
